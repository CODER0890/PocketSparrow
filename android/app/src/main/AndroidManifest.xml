<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================= -->
    <!-- PRIVACY ASSURANCE: ZERO INTERNET PERMISSION DECLARED             -->
    <!-- Pocket Sparrow is strictly air-gapped. android.permission.INTERNET-->
    <!-- is intentionally OMITTED to guarantee zero cloud data leakage.    -->
    <!-- ================================================================= -->

    <!-- Camera for offline CameraX QR (Quishing) scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Local on-device warning notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Query installed/sideloaded APK packages for permission auditing -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SparrowApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@android:drawable/ic_dialog_info"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification Interception Service (SMS, WhatsApp, Telegram, Chat alerts) -->
        <service
            android:name=".services.NotificationScanService"
            android:exported="false"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Background Clipboard Listener Service -->
        <service
            android:name=".services.ClipboardScanService"
            android:exported="false" />

    </application>

</manifest>
